{
  "swagger": "2.0",
  "info": {
    "title": "Kashi",
    "version": "1.0",
    "contact": {
      "name": "mhdna",
      "url": "https://github.com/mhdna"
    }
  },
  "tags": [
    {
      "name": "Kashi"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/inventories": {
      "post": {
        "operationId": "Kashi_CreateInvetory",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pbCreateInventoryResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/pbCreateInventoryRequest"
            }
          }
        ],
        "tags": [
          "Kashi"
        ]
      }
    },
    "/v1/login": {
      "post": {
        "summary": "Login User",
        "description": "Login user and get access token \u0026 refresh token",
        "operationId": "Kashi_LoginUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pbLoginUserResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/pbLoginUserRequest"
            }
          }
        ],
        "tags": [
          "Kashi"
        ]
      }
    }
  },
  "definitions": {
    "pbCreateInventoryRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "pbCreateInventoryResponse": {
      "type": "object",
      "properties": {
        "inventory": {
          "$ref": "#/definitions/pbInventory"
        }
      }
    },
    "pbInventory": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/pbInventoryType"
        }
      }
    },
    "pbInventoryType": {
      "type": "string",
      "enum": [
        "INVENTORY_TYPE_UNSPECIFIED",
        "INVENTORY_TYPE_WAREHOUSE",
        "INVENTORY_TYPE_STORE"
      ],
      "default": "INVENTORY_TYPE_UNSPECIFIED"
    },
    "pbLoginUserRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "pbLoginUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/pbUser"
        },
        "sessionId": {
          "type": "string"
        },
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "accessTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "refreshTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "pbUser": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "activated": {
          "type": "boolean"
        },
        "passwordChangedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
