# /etc/caddy/Caddyfile on the shared droplet (<server-ip>).
#
# SUPERSEDED: this box now also runs kashi-commerce on the bare example.com
# domain, and kashi lives at cloud.example.com instead. The Caddyfile that's
# actually live on the server is ../../../kashi-commerce/deploy/Caddyfile,
# which includes this same block plus kashi-commerce's. Keep both in sync
# if you change kashi's site block.

cloud.example.com {
	encode zstd gzip

	# API: browser calls /api/..., the Go server sees /... on :8090
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8090
	}

	# SPA: serve the built files, fall back to index.html for client routes.
	# Hashed asset filenames change on every rebuild, so they're safe to
	# cache forever; index.html must always be revalidated or browsers keep
	# serving stale hash references after a deploy, which 404s into this
	# same fallback and comes back as text/html where the browser expected
	# a JS module.
	handle {
		root * /var/www/kashi-ui
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
